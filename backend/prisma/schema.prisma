generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ═══ APP (Tenant) ═══

model Store {
  id               Int               @id @default(autoincrement())
  nuvemshopId      String            @unique
  name             String?
  domain           String?
  email            String?
  accessToken      String?
  plan             String            @default("starter")
  trialEndsAt      DateTime?
  uninstalledAt    DateTime? // setado pelo webhook app/uninstalled (null = app instalado)
  stripeCustomerId String?
  partnerId        String?
  partnerName      String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  subscription     Subscription?
  profile          StoreProfile?
  termsAcceptances TermsAcceptance[]
  supportTickets   SupportTicket[]
  cashbackConfig   CashbackConfig?
  customerPoints   CustomerPoints[]
  cashbackTiers    CashbackTier[]
  customerOtps     CustomerOtp[]

  @@map("stores")
}

model StoreProfile {
  id        Int      @id @default(autoincrement())
  storeId   Int      @unique
  store     Store    @relation(fields: [storeId], references: [id])
  data      Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("store_profiles")
}

model Subscription {
  id                   Int       @id @default(autoincrement())
  storeId              Int       @unique
  store                Store     @relation(fields: [storeId], references: [id])
  stripeSubscriptionId String?
  status               String    @default("none")
  planKey              String?
  billingInterval      String?
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@map("subscriptions")
}

model Invoice {
  id              Int       @id @default(autoincrement())
  storeId         Int
  stripeInvoiceId String    @unique
  amountPaid      Float
  currency        String    @default("brl")
  status          String
  invoiceUrl      String?
  invoicePdf      String?
  periodStart     DateTime?
  periodEnd       DateTime?
  createdAt       DateTime  @default(now())

  @@map("invoices")
}

model TermsVersion {
  id          Int               @id @default(autoincrement())
  version     String
  title       String
  content     String
  isPublished Boolean           @default(false)
  publishedAt DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  acceptances TermsAcceptance[]

  @@map("terms_versions")
}

model TermsAcceptance {
  id             Int          @id @default(autoincrement())
  storeId        Int
  store          Store        @relation(fields: [storeId], references: [id])
  termsVersionId Int
  termsVersion   TermsVersion @relation(fields: [termsVersionId], references: [id])
  acceptedAt     DateTime     @default(now())

  @@unique([storeId, termsVersionId])
  @@map("terms_acceptances")
}

// ═══ ADMIN ═══

model AdminUser {
  id           Int            @id @default(autoincrement())
  name         String
  email        String         @unique
  passwordHash String
  role         String         @default("suporte")
  isActive     Boolean        @default(true)
  lastLogin    DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  sessions     AdminSession[]

  @@map("admin_users")
}

model AdminSession {
  id        Int       @id @default(autoincrement())
  adminId   Int
  admin     AdminUser @relation(fields: [adminId], references: [id])
  token     String
  ipAddress String?
  userAgent String?
  isActive  Boolean   @default(true)
  expiresAt DateTime
  createdAt DateTime  @default(now())

  @@map("admin_sessions")
}

model AdminPlan {
  id               Int      @id @default(autoincrement())
  appId            String
  name             String
  stripePriceIds   Json     @default("{}")
  features         Json     @default("{}")
  price            Json     @default("{}")
  commissionRate   Float    @default(0)
  revenueShareRate Float    @default(0)
  isActive         Boolean  @default(true)
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([appId, name])
  @@map("admin_plans")
}

model AdminConfig {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String
  group     String   @default("system")
  label     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("admin_configs")
}

model AdminLog {
  id        Int      @id @default(autoincrement())
  adminId   Int?
  action    String
  entity    String?
  entityId  String?
  details   Json?
  ipAddress String?
  severity  String   @default("info")
  createdAt DateTime @default(now())

  @@map("admin_logs")
}

model AdminCommission {
  id               Int      @id @default(autoincrement())
  partnerId        String
  partnerName      String?
  storeId          Int
  invoiceId        String
  amount           Float
  commissionRate   Float
  commissionAmount Float
  status           String   @default("pending")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([invoiceId]) // 1 comissão por fatura — backstop contra reentrega concorrente
  @@map("admin_commissions")
}

model AdminCoupon {
  id                    Int       @id @default(autoincrement())
  code                  String    @unique
  type                  String
  value                 Float
  maxRedemptions        Int?
  timesRedeemed         Int       @default(0)
  validUntil            DateTime?
  isActive              Boolean   @default(true)
  stripeCouponId        String?
  stripePromotionCodeId String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("admin_coupons")
}

model AdminFaq {
  id          Int      @id @default(autoincrement())
  category    String   @default("geral")
  locale      String   @default("pt") // idioma da FAQ: pt | es
  question    String
  answer      String
  videoUrl    String?
  isPublished Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("admin_faqs")
}

// ─── Suporte (tickets) ─────────────────────────────────────────────────────
// Ticket aberto pela loja (tenant) no app; respondido pelo admin. Thread de
// mensagens (author = store | admin). Isolado por storeId.
model SupportTicket {
  id            Int      @id @default(autoincrement())
  storeId       Int
  subject       String?
  status        String   @default("open") // open | answered | closed
  lastMessageAt DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  store    Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  messages SupportMessage[]

  @@index([storeId])
  @@index([status, lastMessageAt(sort: Desc)])
  @@map("support_tickets")
}

model SupportMessage {
  id        Int      @id @default(autoincrement())
  ticketId  Int
  author    String // store | admin
  body      String
  createdAt DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
  @@map("support_messages")
}

// ─── Cashback / Fidelidade (domínio específico do CashbackPro) ─────────────
// Config do programa por loja (tenant). 1:1 com Store.
model CashbackConfig {
  id                 Int      @id @default(autoincrement())
  storeId            Int      @unique
  store              Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  isActive           Boolean  @default(false)
  // Quando isActive=false (programa pausado): por padrão (false) o cliente
  // continua acessando e resgatando os pontos que já tem — só para de
  // creditar pontos novos. Se true, bloqueia tudo: some o widget e o cliente
  // perde acesso ao próprio saldo até o lojista reativar.
  blockAccessWhenPaused Boolean @default(false)
  pointsPerCurrency  Float    @default(1) // pontos ganhos por unidade de moeda gasta (ex: 1 ponto por R$1)
  // Legado — substituído por CashbackTier (múltiplos níveis). Mantido só para a
  // migração one-off (migrate-tiers.js); o motor de pontos não lê mais estes campos.
  redeemThreshold    Int      @default(100)
  couponType         String   @default("percent_off") // percent_off | amount_off (mesmo shape do AdminCoupon)
  couponValue        Float    @default(10)
  nuvemshopFieldId   String? // id do Customer Custom Field criado na Nuvemshop p/ espelhar o saldo (roadmap: UI Slot)
  welcomeMessage     String?
  redeemMessage      String?
  // Config do widget flutuante na vitrine
  widgetIconPosition String   @default("bottom-right") // bottom-right | bottom-left | top-right | top-left
  widgetIconSize     String   @default("md") // sm | md | lg
  // Ao clicar no ícone flutuante: "overlay" abre o painel lateral embutido
  // (padrão); "page" navega pra página "Minha Fidelidade" da própria loja.
  widgetClickAction  String   @default("overlay")
  // Página "Minha Fidelidade" criada via Nuvemshop Pages API — handle (slug) da
  // página real na loja. Null = ainda não criada.
  customerPageHandle String?
  // Cor da marca da loja (hex), configurável pelo lojista pra combinar com o
  // tema real da vitrine — usada na página "Minha Fidelidade" e no ícone
  // flutuante em vez de uma cor fixa do CashbackPro.
  brandColor         String?  @default("#7C3AED")
  // Cor de fundo da página do cliente (hex) — separada da cor principal, pra
  // o lojista poder ajustar as duas de forma independente.
  brandBackgroundColor String? @default("#F5F3F7")
  // Detecta automaticamente a cor da loja (lida ao vivo da vitrine pelo
  // widget) em vez de usar o brandColor configurado manualmente acima.
  // Desligado por padrão — é uma heurística best-effort, o lojista escolhe
  // manualmente por padrão e liga isso só se quiser.
  brandColorAuto     Boolean  @default(false)
  // Indique e ganhe: liga/desliga e quantos pontos pro indicador e pro indicado
  // (creditados quando o indicado faz a primeira compra paga).
  referralEnabled        Boolean @default(false)
  referralPointsReferrer Int     @default(0)
  referralPointsReferred Int     @default(0)
  // Texto das regras do "Indique e ganhe" (editável pelo lojista, mostrado no
  // modal do cliente). Vazio = usa um texto padrão no front.
  referralRules          String?
  // Bônus de boas-vindas: pontos creditados na 1ª compra do cliente.
  welcomeBonusEnabled Boolean @default(false)
  welcomeBonusPoints  Int     @default(0)
  // Texto "Como funciona" mostrado ao cliente (editável pelo lojista).
  howItWorks         String?
  // Reconquista: e-mail (+pontos opcionais) pra quem não compra há N dias.
  winbackEnabled     Boolean @default(false)
  winbackDays        Int     @default(60)
  winbackPoints      Int     @default(0)
  // Validade dos pontos: "rolling" = cada cliente tem seu próprio ciclo de N
  // meses a partir da última compra; "annual" = todos os clientes da loja
  // vencem em datas fixas, conforme a política do lojista. pointsExpiryAnnualMonth/Day
  // é a data-âncora (1ª ocorrência); pointsExpiryTimesPerYear (1,2,3,4,6,12)
  // repete essa data a cada 12/N meses (ex.: 2x/ano = a cada 6 meses).
  pointsExpiryMode          String @default("rolling")
  pointsExpiryRollingMonths Int    @default(6)
  pointsExpiryAnnualMonth   Int?
  pointsExpiryAnnualDay     Int?
  pointsExpiryTimesPerYear  Int    @default(1)
  // Aviso de pontos a expirar: avisa N dias antes do fim do ciclo.
  pointsExpiryEnabled     Boolean @default(false)
  pointsExpiryWarningDays Int     @default(15)
  // Suporte ao cliente final: mensagem + canais de contato mostrados no
  // dashboard do cliente (não confundir com o suporte do lojista com a gente).
  supportMessage  String?
  supportWhatsapp String? // só dígitos, com DDI (ex: 5511999999999)
  supportEmail    String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("cashback_configs")
}

// Nível de fidelidade configurável pelo lojista (ex: Bronze/Prata/Ouro).
// Resgate consome o tier mais alto que o saldo do cliente alcançar.
model CashbackTier {
  id             Int      @id @default(autoincrement())
  storeId        Int
  store          Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name           String
  pointsRequired Int
  couponType     String // percent_off | amount_off
  couponValue    Float
  sortOrder      Int      @default(0)
  // Ícone (data URI base64, sem storage externo — arquivos pequenos) e cor
  // (hex) do nível, usados no painel e futuramente no widget do cliente.
  icon           String?
  color          String?  @default("#0F7A5C")
  // Benefícios do nível (lista de textos livres, ex.: "Cupom de 10% OFF") e
  // multiplicador de pontos aplicado no crédito enquanto o cliente está neste
  // nível (ex.: 1.2 = ganha 20% a mais). Mostrados no card do cliente.
  benefits         Json?
  pointsMultiplier Float    @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([storeId, sortOrder])
  @@map("cashback_tiers")
}

// Saldo de pontos por cliente final da loja (cliente da Nuvemshop, não confundir com Store).
model CustomerPoints {
  id                  Int      @id @default(autoincrement())
  storeId             Int
  store               Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  nuvemshopCustomerId String // id do cliente na Nuvemshop
  email               String?
  pointsBalance       Int      @default(0)
  // Início do ciclo atual de acúmulo — reseta a cada 6 meses (checagem lazy,
  // feita em ensureCycleFresh() no momento de creditar/resgatar, sem cron job).
  cycleStartedAt      DateTime @default(now())
  // Indique e ganhe: código próprio do cliente (gerado na 1ª visita), o código
  // de quem o indicou, e quando a indicação foi recompensada (só uma vez).
  referralCode        String?  @unique
  referredByCode      String?
  referralRewardedAt  DateTime?
  // Controle dos jobs diários (evita reenviar o mesmo aviso todo dia) e do
  // bônus de boas-vindas (reivindicado de forma atômica — ver rewardWelcome
  // BonusIfDue — pra não creditar 2x numa corrida de requisições).
  winbackSentAt       DateTime?
  pointsExpiryWarnedAt DateTime?
  welcomeBonusGrantedAt DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  transactions PointsTransaction[]
  sessions     CustomerSession[]

  @@unique([storeId, nuvemshopCustomerId])
  @@index([storeId])
  @@index([storeId, referredByCode])
  @@map("customer_points")
}

// Histórico de créditos (compra paga), débitos (resgate de cupom) e resets de
// ciclo de pontos.
model PointsTransaction {
  id               Int            @id @default(autoincrement())
  customerPointsId Int
  customerPoints   CustomerPoints @relation(fields: [customerPointsId], references: [id], onDelete: Cascade)
  storeId          Int // denormalizado — permite listar transações da loja sem join
  type             String // earn | redeem | adjustment | reset
  points           Int // positivo (earn) ou negativo (redeem/adjustment/reset)
  nuvemshopOrderId String? // pedido que originou o crédito (earn)
  couponCode       String? // cupom gerado no resgate (redeem)
  note             String? // texto legível opcional (ex: "Resgate nível Ouro", "Reset de ciclo")
  createdAt        DateTime       @default(now())

  @@index([customerPointsId])
  @@index([storeId, createdAt(sort: Desc)])
  @@map("points_transactions")
}

// Código OTP de login passwordless do cliente final na vitrine (widget).
// Sem FK para CustomerPoints — é solicitado antes de esse registro existir.
model CustomerOtp {
  id                  Int       @id @default(autoincrement())
  storeId             Int
  store               Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  nuvemshopCustomerId String
  email               String
  codeHash            String
  expiresAt           DateTime
  attempts            Int       @default(0)
  consumedAt          DateTime?
  createdAt           DateTime  @default(now())

  @@index([storeId, nuvemshopCustomerId])
  @@map("customer_otps")
}

// Sessão revogável do cliente final (30 dias). Cascade de CustomerPoints —
// ao apagar CustomerPoints (LGPD redact) as sessões morrem junto.
model CustomerSession {
  id               Int            @id @default(autoincrement())
  customerPointsId Int
  customerPoints   CustomerPoints @relation(fields: [customerPointsId], references: [id], onDelete: Cascade)
  storeId          Int // denormalizado — revogar por loja sem join
  token            String         @unique
  userAgent        String?
  ipAddress        String?
  isActive         Boolean        @default(true)
  expiresAt        DateTime
  createdAt        DateTime       @default(now())

  @@index([customerPointsId])
  @@map("customer_sessions")
}
