{
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self' https://*.nuvemshop.com.br https://*.tiendanube.com https://*.mitiendanube.com https://*.mynuvemshop.com"
        }
      ]
    }
  ]
}
